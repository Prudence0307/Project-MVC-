@model RaceEvent
@{ ViewData["Title"] = "Create event"; }
<div class="narrow-page"><a class="back-link" asp-action="Index">← Events</a><div class="form-card"><span class="eyebrow">ORGANISER STUDIO</span><h1>Create an event</h1><p class="muted">Give participants something to look forward to.</p><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="EventName">Event name</label><input asp-for="EventName"/><span asp-validation-for="EventName" class="validation"></span><label asp-for="EventDate">Event date</label><input asp-for="EventDate" type="date"/><span asp-validation-for="EventDate" class="validation"></span><label asp-for="Location">Location</label><input asp-for="Location"/><label asp-for="EventType">Event type</label><select asp-for="EventType"><option>Running</option><option>Walking</option><option>Cycling</option></select><label asp-for="Description">Description</label><textarea asp-for="Description" rows="4"></textarea><button class="btn btn-primary btn-full" type="submit">Create event →</button></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
