@model RaceEvent
@{ ViewData["Title"] = Model.EventName; }
<a class="back-link" asp-action="Index">← All events</a>
<section class="detail-hero"><div><span class="pill">@Model.EventType</span><p class="event-date">@Model.EventDate.ToString("dddd, dd MMMM yyyy")</p><h1>@Model.EventName</h1><p class="event-location">⌖ @Model.Location</p><p>@Model.Description</p><div class="detail-meta"><span>Organised by <b>@Model.Organiser?.FullName</b></span><span>@Model.Categories.Count race categories</span></div></div><div class="detail-art">🏁</div></section>
<div class="section-heading"><div><span class="eyebrow">CHOOSE YOUR CHALLENGE</span><h2>Race categories</h2><p>Select the distance that works for you.</p></div></div>
@if (!Model.Categories.Any()) { <div class="empty-state"><p>Categories have not been added to this event yet.</p></div> } else {
<div class="category-grid">@foreach (var c in Model.Categories) { <article class="category-card"><span class="category-distance">@c.Distance.ToString("0.##") <small>km</small></span><h3>@c.CategoryName</h3><p class="muted">Entry fee</p><div class="category-price">R @c.EntryFee.ToString("0.00")</div><p class="muted">Maximum @c.MaxParticipants participants</p><div class="category-actions"><a class="text-link" asp-controller="Categories" asp-action="Details" asp-route-id="@c.CategoryID">Details & route →</a>@if (User.IsInRole("Participant")) { <form asp-controller="Enrolments" asp-action="Create" method="post"><input type="hidden" name="categoryId" value="@c.CategoryID"/><button class="btn btn-primary" type="submit">Enrol now</button></form> } else if (!User.Identity!.IsAuthenticated) { <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Log in to enrol</a> }</div></article> }</div>
}
@if (User.IsInRole("Organiser") && Model.OrganiserID.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) { <div class="organiser-actions"><a class="btn btn-outline" asp-action="Edit" asp-route-id="@Model.EventID">Edit event</a><a class="btn btn-outline" asp-controller="Categories" asp-action="Create" asp-route-eventId="@Model.EventID">Add category</a><form asp-action="Delete" asp-route-id="@Model.EventID" method="post" onsubmit="return confirm('Delete this event and its categories?')"><button class="btn btn-danger" type="submit">Delete event</button></form></div> }
