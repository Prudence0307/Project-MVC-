@model RaceEvent
@{ ViewData["Title"] = "Edit event"; }
<div class="narrow-page"><a class="back-link" asp-action="Details" asp-route-id="@Model.EventID">← Back to event</a><div class="form-card"><h1>Edit event</h1><form asp-action="Edit" method="post"><input type="hidden" asp-for="EventID"/><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="EventName">Event name</label><input asp-for="EventName"/><label asp-for="EventDate">Event date</label><input asp-for="EventDate" type="date"/><label asp-for="Location">Location</label><input asp-for="Location"/><label asp-for="EventType">Event type</label><select asp-for="EventType"><option>Running</option><option>Walking</option><option>Cycling</option></select><label asp-for="Description">Description</label><textarea asp-for="Description" rows="4"></textarea><button class="btn btn-primary btn-full" type="submit">Save changes</button></form></div></div>
