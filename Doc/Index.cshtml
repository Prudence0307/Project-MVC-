@model IEnumerable<RaceEvent>
@{
    ViewData["Title"] = "Home";
}
<section class="hero">
  <div class="hero-copy">
    <span class="eyebrow">YOUR NEXT CHALLENGE STARTS HERE</span>
    <h1>Every race has a story.<br/><span>Make yours count.</span></h1>
    <p>Discover running events, cycling tours and community walks. Find your distance, sign up and cross your next finish line.</p>
    <div class="hero-actions"><a class="btn btn-primary btn-large" asp-controller="Events" asp-action="Index">Explore events <span>→</span></a><a class="text-link" href="#upcoming">See what's coming up ↓</a></div>
  </div>
  <div class="hero-art"><div class="sun"></div><div class="art-label label-top">FIND YOUR PACE</div><div class="runner">🏃</div><div class="track track-one"></div><div class="track track-two"></div><div class="art-label label-bottom">READY. SET. GO.</div></div>
</section>
<section class="stats">
  <div><strong>@ViewBag.EventCount</strong><span>Events listed</span></div>
  <div><strong>@ViewBag.ParticipantCount</strong><span>Participants</span></div>
  <div><strong>@ViewBag.EnrolmentCount</strong><span>Confirmed entries</span></div>
</section>
<section id="upcoming" class="section">
  <div class="section-heading"><div><span class="eyebrow">MARK YOUR CALENDAR</span><h2>Upcoming events</h2><p>Pick an event and make it your next big moment.</p></div><a class="text-link" asp-controller="Events" asp-action="Index">View all events →</a></div>
  @if (!Model.Any()) { <div class="empty-state"><h3>No upcoming events just yet</h3><p>Check back soon or browse all listed events.</p><a class="btn btn-primary" asp-controller="Events" asp-action="Index">Browse events</a></div> }
  else {
  <div class="event-grid">
  @foreach (var ev in Model) {
    <article class="event-card">
      <div class="event-card-top"><span class="event-icon">@((ev.EventType == "Cycling") ? "🚴" : (ev.EventType == "Walking") ? "🚶" : "🏃")</span><span class="pill">@ev.EventType</span></div>
      <p class="event-date">@ev.EventDate.ToString("ddd, dd MMM yyyy")</p><h3>@ev.EventName</h3><p class="event-location">⌖ @ev.Location</p>
      <div class="card-bottom"><span>@ev.Categories.Count category options</span><a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventID">Details <b>→</b></a></div>
    </article>
  }
  </div>
  }
</section>
<section class="cta"><div><span class="eyebrow">HOSTING AN EVENT?</span><h2>Bring your community together.</h2><p>Create an event, add race categories and manage participants in one place.</p></div><a class="btn btn-light" asp-controller="Account" asp-action="Register">Become an organiser →</a></section>
