@model IEnumerable<Enrolment>
@{ ViewData["Title"] = "My enrolments"; }
<div class="page-heading"><div><span class="eyebrow">YOUR RACE CALENDAR</span><h1>My enrolments</h1><p>All your event entries, together in one place.</p></div><a class="btn btn-primary" asp-controller="Events" asp-action="Index">Find an event</a></div>
@if (!Model.Any()) { <div class="empty-state"><h3>Your next adventure is waiting</h3><p>You haven't enrolled in any categories yet.</p><a class="btn btn-primary" asp-controller="Events" asp-action="Index">Explore events</a></div> } else {
<div class="table-wrap"><table><thead><tr><th>Event</th><th>Category</th><th>Date</th><th>Status</th><th>Result</th><th></th></tr></thead><tbody>@foreach (var e in Model) { <tr><td><strong>@e.Category?.Event?.EventName</strong><small>@e.Category?.Event?.Location</small></td><td>@e.Category?.CategoryName</td><td>@e.Category?.Event?.EventDate.ToString("dd MMM yyyy")</td><td><span class="status">@e.Status</span></td><td>@(e.Result?.FinishTime?.ToString(@"hh\:mm\:ss") ?? "—")</td><td>@if (e.Status == "Confirmed") { <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this enrolment?')"><input type="hidden" name="id" value="@e.EnrolmentID"/><button class="text-button" type="submit">Cancel</button></form> }</td></tr> }</tbody></table></div>
}
