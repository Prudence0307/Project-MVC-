<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
  <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RaceDay</a>
  <nav>
    <a asp-controller="Events" asp-action="Index">Events</a>
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Participant")) { <a asp-controller="Enrolments" asp-action="Mine">My Enrolments</a> }
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Organiser")) { <a asp-controller="Events" asp-action="Create">Create Event</a> }
  </nav>
  <div class="account">
  @if (User.Identity?.IsAuthenticated == true) {
    <span class="welcome">Hi, @User.Identity.Name</span>
    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline" type="submit">Log out</button></form>
  } else {
    <a class="nav-login" asp-controller="Account" asp-action="Login">Log in</a>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Get started</a>
  }
  </div>
</header>
<main class="container">
  @if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
  @if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
  @RenderBody()
</main>
<footer class="footer"><span>© @DateTime.Now.Year RaceDay</span><span>Find your next finish line.</span></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
